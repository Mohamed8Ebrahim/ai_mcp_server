<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="m7_mcp_ai_connector.StatusPill">
        <span t-attf-class="o_mcp_pill o_mcp_pill--#{widget.pill.value}"
              t-att-title="widget.pill.label">
            <span t-attf-class="o_mcp_dot #{widget.pill.live ? 'o_mcp_dot--live' : ''}"/>
            <span t-esc="widget.pill.label"/>
        </span>
    </t>

    <t t-name="m7_mcp_ai_connector.McpCopy">
        <div t-attf-class="#{isBlock ? 'o_mcp_copy o_mcp_copy--block' : 'o_mcp_copy'}">
            <t t-if="isBlock">
                <pre class="o_mcp_pre" style="direction:ltr;text-align:left;unicode-bidi:isolate;" t-esc="value"/>
            </t>
            <t t-elif="isEmpty">
                <span class="o_mcp_inline o_mcp_inline--empty">—</span>
            </t>
            <t t-else="">
                <span class="o_mcp_inline" style="direction:ltr;text-align:left;unicode-bidi:isolate;" t-esc="value"/>
            </t>
            <button type="button" class="o_mcp_copy_btn" t-att-disabled="isEmpty ? 'disabled' : undefined" title="Copy to clipboard">
                <i class="fa fa-clipboard"/>
                <span>Copy</span>
            </button>
        </div>
    </t>

</templates>
