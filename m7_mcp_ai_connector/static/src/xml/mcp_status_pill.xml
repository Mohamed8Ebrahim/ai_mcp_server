<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="m7_mcp_ai_connector.StatusPill">
        <span class="o_mcp_pill" t-att-class="'o_mcp_pill--' + pill.value"
              t-att-title="pill.label">
            <span class="o_mcp_dot" t-att-class="pill.live ? 'o_mcp_dot--live' : ''"/>
            <span t-esc="pill.label"/>
        </span>
    </t>

    <t t-name="m7_mcp_ai_connector.McpCopy">
        <div t-att-class="isBlock ? 'o_mcp_copy o_mcp_copy--block' : 'o_mcp_copy'">
            <pre t-if="isBlock" class="o_mcp_pre"
                 style="direction:ltr;text-align:left;unicode-bidi:isolate;" t-esc="value"/>
            <span t-else="" class="o_mcp_inline"
                  style="direction:ltr;text-align:left;unicode-bidi:isolate;" t-esc="value"/>
            <button type="button" class="o_mcp_copy_btn" t-on-click="onCopy"
                    t-att-title="state.copied ? 'Copied!' : 'Copy to clipboard'">
                <i class="fa" t-att-class="state.copied ? 'fa-check' : 'fa-clipboard'"/>
                <span t-esc="state.copied ? 'Copied!' : 'Copy'"/>
            </button>
        </div>
    </t>

</templates>
