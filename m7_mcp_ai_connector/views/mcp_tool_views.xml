<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mcp_tool_tree" model="ir.ui.view">
        <field name="name">mcp.tool.tree</field>
        <field name="model">mcp.tool</field>
        <field name="arch" type="xml">
            <tree class="o_mcp_list"
                  create="false"
                  delete="false"
                  editable="bottom"
                  decoration-muted="not enabled">
                <field name="sequence" optional="hide" readonly="1"/>
                <field name="name" readonly="1"/>
                <field name="technical_name" readonly="1"/>
                <field name="required_scope" readonly="1"/>
                <field name="description" readonly="1"/>
                <field name="enabled" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_mcp_tool_form" model="ir.ui.view">
        <field name="name">mcp.tool.form</field>
        <field name="model">mcp.tool</field>
        <field name="arch" type="xml">
            <form class="o_mcp_form" create="false" delete="false">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Tools are defined in the module code. You can only toggle
                        <strong>Enabled</strong> here — create, delete and other
                        fields are locked.
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="technical_name" readonly="1"/>
                            <field name="required_scope" readonly="1"/>
                        </group>
                        <group>
                            <field name="sequence" readonly="1"/>
                            <field name="enabled" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Description (sent to the AI client)">
                        <field name="description" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mcp_tool" model="ir.actions.act_window">
        <field name="name">Tools</field>
        <field name="res_model">mcp.tool</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
