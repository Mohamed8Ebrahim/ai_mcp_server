<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mcp_log_list" model="ir.ui.view">
        <field name="name">mcp.log.list</field>
        <field name="model">mcp.log</field>
        <field name="arch" type="xml">
            <list class="o_mcp_list" decoration-danger="not success" create="false" edit="false">
                <field name="create_date"/>
                <field name="token_id"/>
                <field name="user_id"/>
                <field name="tool_name"/>
                <field name="model_name"/>
                <field name="result_summary"/>
                <field name="duration_ms" widget="float" digits="[6,1]"/>
                <field name="client_ip"/>
                <field name="success"/>
            </list>
        </field>
    </record>

    <record id="view_mcp_log_form" model="ir.ui.view">
        <field name="name">mcp.log.form</field>
        <field name="model">mcp.log</field>
        <field name="arch" type="xml">
            <form class="o_mcp_form" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="token_id"/>
                            <field name="user_id"/>
                            <field name="method"/>
                            <field name="tool_name"/>
                            <field name="model_name"/>
                        </group>
                        <group>
                            <field name="success"/>
                            <field name="result_summary"/>
                            <field name="duration_ms"/>
                            <field name="client_ip"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <group string="Arguments">
                        <field name="arguments" nolabel="1"/>
                    </group>
                    <group string="Error" invisible="success">
                        <field name="error_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mcp_log_search" model="ir.ui.view">
        <field name="name">mcp.log.search</field>
        <field name="model">mcp.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="token_id"/>
                <field name="tool_name"/>
                <field name="model_name"/>
                <field name="user_id"/>
                <filter name="success" string="Success" domain="[('success','=',True)]"/>
                <filter name="errors" string="Errors" domain="[('success','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_tool" string="Tool" context="{'group_by':'tool_name'}"/>
                    <filter name="group_model" string="Model" context="{'group_by':'model_name'}"/>
                    <filter name="group_token" string="Token" context="{'group_by':'token_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by':'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mcp_log" model="ir.actions.act_window">
        <field name="name">Audit Logs</field>
        <field name="res_model">mcp.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_errors': 0}</field>
    </record>

</odoo>
