<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="module_category_mcp" model="ir.module.category">
        <field name="name">MCP Server</field>
        <field name="description">Manage AI (Model Context Protocol) access to Odoo.</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_mcp_user" model="res.groups">
        <field name="name">MCP User</field>
        <field name="category_id" ref="module_category_mcp"/>
        <field name="comment">Can create and manage their own MCP access tokens.</field>
    </record>

    <record id="group_mcp_admin" model="res.groups">
        <field name="name">MCP Administrator</field>
        <field name="category_id" ref="module_category_mcp"/>
        <field name="implied_ids" eval="[(4, ref('group_mcp_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Full control over MCP tokens, tools, settings and audit logs across all users.</field>
    </record>

    <!-- A regular MCP user only sees and manages their own tokens -->
    <record id="rule_mcp_token_own" model="ir.rule">
        <field name="name">MCP Token: own tokens only</field>
        <field name="model_id" ref="model_mcp_token"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_mcp_user'))]"/>
    </record>

    <record id="rule_mcp_token_admin" model="ir.rule">
        <field name="name">MCP Token: administrators see all</field>
        <field name="model_id" ref="model_mcp_token"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_mcp_admin'))]"/>
    </record>

    <!-- Logs: users see logs of their own tokens; admins see everything -->
    <record id="rule_mcp_log_own" model="ir.rule">
        <field name="name">MCP Log: own tokens only</field>
        <field name="model_id" ref="model_mcp_log"/>
        <field name="domain_force">[('token_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_mcp_user'))]"/>
    </record>

    <record id="rule_mcp_log_admin" model="ir.rule">
        <field name="name">MCP Log: administrators see all</field>
        <field name="model_id" ref="model_mcp_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_mcp_admin'))]"/>
    </record>

</odoo>
