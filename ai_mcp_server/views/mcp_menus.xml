<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem id="menu_mcp_root" name="MCP Server"
              web_icon="ai_mcp_server,static/description/icon.png"
              sequence="95" groups="ai_mcp_server.group_mcp_user"/>

    <menuitem id="menu_mcp_tokens" name="AI Access Keys"
              parent="menu_mcp_root" action="action_mcp_token" sequence="10"
              groups="ai_mcp_server.group_mcp_user"/>

    <menuitem id="menu_mcp_logs" name="Audit Logs"
              parent="menu_mcp_root" action="action_mcp_log" sequence="20"
              groups="ai_mcp_server.group_mcp_user"/>

    <menuitem id="menu_mcp_config" name="Configuration"
              parent="menu_mcp_root" sequence="90"
              groups="ai_mcp_server.group_mcp_admin"/>

    <menuitem id="menu_mcp_tools" name="Tools"
              parent="menu_mcp_config" action="action_mcp_tool" sequence="10"
              groups="ai_mcp_server.group_mcp_admin"/>

    <menuitem id="menu_mcp_settings" name="Settings"
              parent="menu_mcp_config" action="action_mcp_config_settings" sequence="20"
              groups="ai_mcp_server.group_mcp_admin"/>

</odoo>
