<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mcp_tool_tree" model="ir.ui.view">
        <field name="name">mcp.tool.tree</field>
        <field name="model">mcp.tool</field>
        <field name="arch" type="xml">
            <tree class="o_mcp_list" editable="bottom" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="technical_name"/>
                <field name="required_scope"/>
                <field name="description"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_mcp_tool_form" model="ir.ui.view">
        <field name="name">mcp.tool.form</field>
        <field name="model">mcp.tool</field>
        <field name="arch" type="xml">
            <form class="o_mcp_form">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="technical_name"/>
                            <field name="required_scope"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description (sent to the AI client)">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mcp_tool" model="ir.actions.act_window">
        <field name="name">Tools</field>
        <field name="res_model">mcp.tool</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
