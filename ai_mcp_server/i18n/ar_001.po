#. module: ai_mcp_server
#: model_terms:ir.ui.view,arch_db:ai_mcp_server.view_mcp_token_reveal_form
msgid "<b>Name:</b> any label (e.g. Odoo MCP)."
msgstr "<b>الاسم:</b> أي تسمية (مثل Odoo MCP)."

#. module: ai_mcp_server
#: model_terms:ir.ui.view,arch_db:ai_mcp_server.view_mcp_token_reveal_form
msgid "<b>Remote MCP server URL:</b> paste the Connector URL above."
msgstr "<b>عنوان خادم MCP البعيد:</b> الصق عنوان الموصّل (URL) الموضّح أعلاه."

#. module: ai_mcp_server
#: model_terms:ir.ui.view,arch_db:ai_mcp_server.view_mcp_token_reveal_form
msgid "<i class=\"fa fa-exclamation-triangle fa-lg me-2\" title=\"Warning\"/>"
msgstr ""

#. module: ai_mcp_server
#: model_terms:ir.ui.view,arch_db:ai_mcp_server.view_mcp_token_form
msgid ""
"<i class=\"fa fa-info-circle me-1\" title=\"Info\"/>\n"
"                                Leave both lists <b>empty</b> for full access to everything the acting user\n"
"                                can already reach. Add entries only to <b>narrow</b> the token down."
msgstr ""
"<i class=\"fa fa-info-circle me-1\" title=\"Info\"/>\n"
"                                اترك القائمتين <b>فارغتين</b> للحصول على وصول كامل إلى كل ما يستطيع المستخدم المنفِّذ\n"
"                                الوصول إليه بالفعل. أضِف مدخلات فقط لأجل <b>تضييق</b> صلاحيات التوكن."

#. module: ai_mcp_server
#: model_terms:ir.ui.view,arch_db:ai_mcp_server.view_mcp_token_reveal_form
msgid ""
"<strong>Copy your secret now.</strong>\n"
"                        For security the token is stored only as a hash and\n"
"                        <b>will never be shown again</b>. If you lose it, click Regenerate."
msgstr ""
"<strong>انسخ توكنك السرّي الآن.</strong>\n"
"                        لأغراض الأمان يُخزَّن التوكن كقيمة تجزئة (hash) فقط،\n"
"                        و<b>لن يُعرض مرة أخرى أبداً</b>. إذا فقدته، انقر على إعادة التوليد."

#. module: ai_mcp_server
#: model:ir.model.fields,help:ai_mcp_server.field_mcp_token__name
msgid "A human friendly label to identify where this access token is used (e.g. 'Claude Desktop - Ahmed')."
msgstr "تسمية واضحة للتعرّف على المكان الذي يُستخدم فيه توكن الوصول هذا (مثل 'Claude Desktop - Ahmed')."

#. module: ai_mcp_server
#: model_terms:ir.ui.view,arch_db:ai_mcp_server.view_mcp_token_form
msgid "A label to recognise where this token is used."
msgstr "تسمية للتعرّف على المكان الذي يُستخدم فيه هذا التوكن."

#. module: ai_mcp_server
#: model:ir.model.fields,help:ai_mcp_server.field_mcp_token__token_preview
msgid "A masked preview of the secret token showing only its last characters for identification."
msgstr "معاينة مُقنّعة للتوكن السرّي تُظهر أحرفه الأخيرة فقط لأغراض التعرّف."

#. module: ai_mcp_server
#. odoo-python
